# /etc/filerelay.env  (chmod 600, owned by root)
RELAY_LISTEN=127.0.0.1:8080
RELAY_DATA=/var/lib/filerelay
# Generate with: openssl rand -base64 24 | tr '+/' '-_'
RELAY_TOKEN=change-me-read-write-token
# Optional: give the destination server only this one.
RELAY_READ_TOKEN=change-me-read-only-token
RELAY_TTL=72h
RELAY_MAX_UPLOAD=0
# The URL A and B use to reach this relay (shown in the UI and /agent.md).
RELAY_PUBLIC_URL=https://relay.example.com
# Optional: automatic HTTPS (then RELAY_LISTEN=:443 and open ports 80+443).
#RELAY_DOMAIN=relay.example.com
#RELAY_ACME_EMAIL=you@example.com
